# First run: set a strong password. If omitted, a random password is printed once in server logs.
AGENT_ADMIN_USERNAME=admin
AGENT_ADMIN_PASSWORD=replace-with-a-strong-password
AGENT_SECRET_KEY=replace-with-a-long-random-secret
AGENT_DATA_DIR=./data
COMPOSE_PROJECT_NAME=personal-agent

# AI provider: mimo (default) or minimax. The selected provider handles LLM, ASR and TTS.
AGENT_AI_PROVIDER=mimo
# Optional per-capability overrides. Example: MiniMax LLM + Xiaomi MiMo ASR/TTS.
# AGENT_LLM_PROVIDER=minimax
# AGENT_ASR_PROVIDER=mimo
# AGENT_TTS_PROVIDER=mimo

# Xiaomi MiMo cloud API
AGENT_MIMO_API_KEY=
AGENT_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
AGENT_MIMO_LLM_MODEL=mimo-v2.6-flash
AGENT_MIMO_ASR_MODEL=mimo-v2.5-asr
AGENT_MIMO_TTS_MODEL=mimo-v2.5-tts
AGENT_MIMO_VOICE=mimo_default

# MiniMax OpenAI-compatible chat, multipart ASR and streaming PCM TTS
AGENT_MINIMAX_API_KEY=
AGENT_MINIMAX_REGION=global
AGENT_MINIMAX_BASE_URL=https://api.minimax.io/v1
AGENT_MINIMAX_LLM_MODEL=MiniMax-M3.1-Flash
AGENT_MINIMAX_ASR_MODEL=asr-1.0
AGENT_MINIMAX_TTS_MODEL=speech-2.8-turbo
AGENT_MINIMAX_VOICE=Chinese (Mandarin)_Lyrical_Voice
AGENT_MINIMAX_REASONING_EFFORT=medium

# Persistent task pools
AGENT_MAX_ASYNC_TASKS=4
AGENT_MAX_THREAD_WORKERS=2
AGENT_MAX_BROWSER_SESSIONS=1
AGENT_TASK_TIMEOUT_SECONDS=600

# Internal executor
AGENT_EXECUTOR_BASE_URL=http://executor:8081
AGENT_EXECUTOR_TOKEN=replace-with-an-internal-random-token
